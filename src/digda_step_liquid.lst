                              <<<    PREFETCH(HARD) Expected by compiler :
                              <<<      eb, bet, ex, ed, ew
                              <<< Loop-information  End >>>
        347     2        v            do ij = ijtstr, ijtend
        348     2        v               ew(ij, k) = ec(k-1) / bet(ij)
        349     2        v               bet(ij)   = eb(ij, k) - ea(k) * ew(ij, k)
        350     2        v               ex(ij, k) = (ed(ij, k) - ea(k) * ex(ij, k-1) ) / bet(ij)
        351     2        v            end do
        352     1                     end do
