        330                           subroutine calc_tridiagonal_liquid( ea, eb, ec, ed, ex )
        331                     
        332                           double precision, intent(in)  :: ea(sdzdim), eb(nxy,sdzdim), ec(sdzdim)
        333                           double precision, intent(in)  :: ed(nxy,sdzdim)
        334                           double precision, intent(out) :: ex(nxy,sdzdim)
        335                     
        336                           double precision :: ew(nxy,sdzdim)
        337                           double precision :: bet(nxy)
        338                     
        339                           integer :: ij, k
        340                     
                              <<< Loop-information Start >>>
                              <<<  [OPTIMIZATION]
                              <<<    SIMD(VL: 8)
                              <<<    SOFTWARE PIPELINING(IPC: 1.93, ITR: 112, MVE: 4, POL: S)
                              <<<    PREFETCH(HARD) Expected by compiler :
                              <<<      ed, eb, ex, bet
                              <<< Loop-information  End >>>
        341     1       2v            do ij = ijtstr, ijtend
        342     1       2v               bet(ij)      = eb(ij, skst)
        343     1       2v               ex(ij, skst) = ed(ij, skst) / bet(ij)
        344     1       2v            end do
        345                     
                              <<< Loop-information Start >>>
                              <<<  [OPTIMIZATION]
                              <<<    PREFETCH(HARD) Expected by compiler :
