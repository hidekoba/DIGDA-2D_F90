#FC	= mpiifort
FC	= mpiifx

FFLAGS=-O3 -u -convert big_endian -traceback -mcmodel=large -I/home/hidekoba/local/netcdf4-intel-fortran/4.6.2/include

FOPTION	= $(FFLAGS) -L/home/hidekoba/local/netcdf4-intel-fortran/4.6.2/lib -L/home/hidekoba/local/netcdf4-intel/4.9.3/lib -lnetcdff -lnetcdf -lm

.f90.o:
	$(FC) $(FOPTION) -c $<

%.o: %.f90
	$(FC) $(FFLAGS) -c $< -o $@
