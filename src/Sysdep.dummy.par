FC = mpiifort

FFLAGS = -O3 -u -convert big_endian -traceback -mcmodel=large \
         -I/path/to/netcdf4-intel-fortran/4.6.0/include

FOPTION = $(FFLAGS) \
          -L/path/to/netcdf4-intel-fortran/4.6.0/lib \
          -L/path/to/netcdf4-intel/4.9.2/lib \
          -lnetcdff -lnetcdf -lm

.f90.o:
	$(FC) $(FOPTION) -c $<

%.o: %.f90
	$(FC) $(FFLAGS) -c $< -o $@
