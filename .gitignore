# ==========================================
# Machine-specific compilation settings
# ==========================================

# Mkinclude
/src/Mkinclude.*
!/src/Mkinclude.dummy

# System-dependent compiler settings
/src/Sysdep.*.par
!/src/Sysdep.dummy.par

# Compilation scripts
/src/compile_*.sh
!/src/compile_dummy.sh


# ==========================================
# Machine-specific execution scripts
# ==========================================

# Ignore execution scripts
/RUN/*.sh

# Keep public example scripts
!/RUN/*_dummy.sh


# ==========================================
# Machine-specific initial file scripts
# ==========================================

# Initial-condition scripts
/init/mkinit*.sh
!/init/*_dummy.sh

# Generated initial conditions
/init/*.nc
